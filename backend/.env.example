# Server Configuration
PORT=3001
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/tenderchain
MONGODB_TEST_URI=mongodb://localhost:27017/tenderchain_test

# Connection pool and timeouts (all optional; defaults shown).
# Indexes are created by migrations (`npm run migrate`) rather than autoIndex,
# which is only enabled when NODE_ENV=development.
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=2
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=45000
# Startup retry policy. Worst-case startup delay is roughly
# retries * serverSelectionTimeout plus exponential backoff, so keep both modest.
MONGODB_MAX_RETRIES=5
MONGODB_RETRY_DELAY_MS=1000

# Redis — holds sessions, rate-limit counters and cached chain reads.
# Required: sessions live here, so the API fails closed without it.
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=tc
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_MAX_RETRIES=10

# Sessions
SESSION_TTL_SECONDS=2592000
# How long a wallet proof keeps its on-chain capability before it must be
# re-proven. Short on purpose: the ability to move value should not last the
# whole life of a month-long session.
ONCHAIN_CAPABILITY_TTL_SECONDS=900

# JWT Configuration
# Must be at least 32 characters and must not be left as this placeholder -
# tokenService refuses to issue tokens otherwise.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=your_super_secret_jwt_key_here
# Access tokens are deliberately short-lived; revocation happens at the refresh
# layer, which is stateful. The old single 7d token could not be revoked at all.
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE_DAYS=30
JWT_ISSUER=tenderchain
JWT_AUDIENCE=tenderchain-api

# Sign-In With Ethereum (EIP-4361)
# SIWE_DOMAIN must match the origin the frontend is served from, or signatures
# produced for another site would be accepted here.
SIWE_DOMAIN=localhost:3002
SIWE_URI=http://localhost:3002
SIWE_CHAIN_ID=1337
SIWE_NONCE_TTL_MS=300000

# Max auth attempts per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=20

# Password authentication
# Length dominates strength; the policy also requires two character classes and
# rejects passwords containing the user's own name or email local-part.
PASSWORD_MIN_LENGTH=12
# Account lock after this many consecutive failures, for this long. The lock is
# time-boxed so a third party cannot lock someone out indefinitely by guessing.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
# Used to build the reset link sent by email.
FRONTEND_BASE_URL=http://localhost:3002

# CORS: comma-separated browser origins allowed to call this API.
# Must include the origin the frontend is served from, or every browser request
# fails preflight. Required in production; defaults to localhost:3002 in dev.
CORS_ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# Blockchain Configuration
WEB3_PROVIDER_URL=http://localhost:8545
GANACHE_MNEMONIC=your_ganache_mnemonic_here

# Contract Addresses (update after deployment)
FACTORY_TENDER_ADDRESS=0x5f8e26fAcC23FA4cbd87b8d9Dbbd33D5047abDE1
FACTORY_CONTRACTOR_ADDRESS=0x2612Af3A521c2df9EAF28422Ca335b04AdF3ac66
FACTORY_GOVERNMENT_OFFICER_ADDRESS=0xA57B8a5584442B467b4689F1144D269d096A3daF
TENDER_REPO_ADDRESS=0x254dffcd3277C0b1660F6d42EFbB754edaBAbC2B
CONTRACTOR_REPO_ADDRESS=0xD833215cBcc3f914bD1C9ece3EE7BF8B14f841bb
GOVERNMENT_OFFICER_REPO_ADDRESS=0xCfEB869F69431e42cdB54A4F4f105C19C080A601

# IPFS — content-addressed storage for documents and milestone evidence.
# Driver: 'kubo' talks to a local node, 'memory' keeps content in-process and is
# used automatically under NODE_ENV=test so the suite needs no daemon.
IPFS_DRIVER=kubo
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY_URL=https://ipfs.io

# Screening service (Python, ml-service/). Advisory: if it is unreachable the
# upload still proceeds and the artefact is recorded as unscreened.
SCREENING_SERVICE_URL=http://127.0.0.1:8000
SCREENING_TIMEOUT_MS=15000
# Risk at or above which an artefact is queued for a human verifier. Nothing is
# ever blocked on this.
SCREENING_REVIEW_THRESHOLD=30
MAX_ARTEFACT_BYTES=26214400

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# Without SMTP_HOST and SMTP_USER, mail is logged instead of sent in dev; in
# production the app refuses rather than silently dropping a password reset.
SMTP_FROM=TenderChain <no-reply@tenderchain.local>
SMTP_PASS=your_app_password

# Admin Configuration
ADMIN_WALLET_ADDRESS=0x742d35Cc6636C0532925a3b8F5e52f4424E80A42
