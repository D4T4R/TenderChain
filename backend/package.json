{
  "name": "tenderchain-backend",
  "version": "1.0.0",
  "description": "Backend API for TenderChain - Blockchain-based Tender Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "migrate": "migrate-mongo up",
    "migrate:down": "migrate-mongo down",
    "migrate:status": "migrate-mongo status"
  },
  "dependencies": {
    "@huggingface/inference": "^4.7.1",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "compression": "^1.7.4",
    "compromise": "^14.14.4",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.0.3",
    "ethers": "^6.17.0",
    "express": "^4.22.2",
    "express-rate-limit": "^6.7.0",
    "express-validator": "^6.15.0",
    "helmet": "^6.0.1",
    "ipfs-http-client": "^60.0.0",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.0",
    "mammoth": "^1.11.0",
    "migrate-mongo": "^14.0.7",
    "moment": "^2.29.4",
    "mongoose": "^7.8.11",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "natural": "^8.1.0",
    "pdf-parse": "^1.1.1",
    "redis": "^4.7.1",
    "siwe": "^3.0.0",
    "uuid": "^14.0.0",
    "web3": "^4.16.0",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "jest": "^29.5.0",
    "nodemon": "^2.0.22",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "blockchain",
    "tender",
    "smart-contracts",
    "mongodb",
    "ipfs",
    "web3"
  ],
  "author": "TenderChain Team",
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "testTimeout": 30000
  }
}
